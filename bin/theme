#!/usr/bin/env bash
# Switch the Neovim theme, the matching Ghostty terminal theme and the
# GTK4/libadwaita colors (Nautilus and other GNOME apps) together.
#
# Usage:
#   theme            List available themes and show the current one
#   theme <name>     Activate <name> in Neovim, Ghostty and GTK4 apps
set -euo pipefail

NVIM_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
THEMES_DIR="$NVIM_DIR/lua/themes"
TARGET="$NVIM_DIR/lua/plugins/theme.lua"
GHOSTTY_THEMES_DIR="$NVIM_DIR/extras/ghostty/themes"
GHOSTTY_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/ghostty"
GTK4_CSS="${XDG_CONFIG_HOME:-$HOME/.config}/gtk-4.0/gtk.css"
GTK4_MARKER="Generated by nvim bin/theme"

# Ghostty 1.2+ reads config.ghostty; older installs use config.
if [[ -f "$GHOSTTY_DIR/config" && ! -f "$GHOSTTY_DIR/config.ghostty" ]]; then
  GHOSTTY_CONFIG="$GHOSTTY_DIR/config"
else
  GHOSTTY_CONFIG="$GHOSTTY_DIR/config.ghostty"
fi

# Built-in Ghostty themes that match a Neovim theme. Anything not listed here
# must have a custom theme file in extras/ghostty/themes/<name>.
ghostty_theme_for() {
  case "$1" in
    kanagawa-dragon) echo "Kanagawa Dragon" ;;
    kanso) echo "Kanso Zen" ;;
    matte-black) echo "Matte Black" ;;
    miasma) echo "Miasma" ;;
    vague) echo "Vague" ;;
    vesper) echo "Vesper" ;;
    *)
      if [[ -f "$GHOSTTY_THEMES_DIR/$1" ]]; then
        echo "$GHOSTTY_THEMES_DIR/$1"
      fi
      ;;
  esac
}

# Palette index used as the GTK accent color. Defaults to 4 (blue).
gtk_accent_index_for() {
  case "$1" in
    vesper) echo 11 ;; # Vesper's signature orange
    *) echo 4 ;;
  esac
}

# Resolve a Ghostty theme value (built-in name or absolute path) to a file.
ghostty_theme_file() {
  local value="$1"
  if [[ "$value" == /* ]]; then
    [[ -f "$value" ]] && echo "$value"
    return 0
  fi
  local dir
  for dir in \
    "$GHOSTTY_DIR/themes" \
    "${GHOSTTY_RESOURCES_DIR:-/nonexistent}/themes" \
    /usr/share/ghostty/themes \
    /usr/local/share/ghostty/themes \
    "$HOME/.local/share/ghostty/themes" \
    /snap/ghostty/current/share/ghostty/themes; do
    if [[ -f "$dir/$value" ]]; then
      echo "$dir/$value"
      return 0
    fi
  done
}

# Print the color for a Ghostty key ("background", "palette:4", ...).
ghostty_color() {
  local file="$1" key="$2"
  if [[ "$key" == palette:* ]]; then
    sed -nE "s/^[[:space:]]*palette[[:space:]]*=[[:space:]]*${key#palette:}=[[:space:]]*\"?(#[0-9A-Fa-f]{6})\"?.*/\1/p" "$file" | tail -1
  else
    sed -nE "s/^[[:space:]]*${key}[[:space:]]*=[[:space:]]*\"?(#?[0-9A-Fa-f]{6})\"?.*/\1/p" "$file" | tail -1 | sed -E 's/^([0-9A-Fa-f])/#\1/'
  fi
}

# Readable text color on top of $1: the darker or lighter of $2/$3.
contrast_fg() {
  local color="$1" dark="$2" light="$3"
  local hex="${color#\#}"
  local r=$((16#${hex:0:2})) g=$((16#${hex:2:2})) b=$((16#${hex:4:2}))
  # Perceived brightness (ITU-R BT.601), 0..255000.
  if (((r * 299 + g * 587 + b * 114) > 140000)); then
    echo "$dark"
  else
    echo "$light"
  fi
}

# Write ~/.config/gtk-4.0/gtk.css with libadwaita named colors derived from
# the Ghostty theme, so Nautilus and other GTK4 apps follow the theme.
set_gtk4_colors() {
  local name="$1" file="$2"
  local bg fg red green yellow accent
  bg="$(ghostty_color "$file" background)"
  fg="$(ghostty_color "$file" foreground)"
  red="$(ghostty_color "$file" palette:1)"
  green="$(ghostty_color "$file" palette:2)"
  yellow="$(ghostty_color "$file" palette:3)"
  accent="$(ghostty_color "$file" "palette:$(gtk_accent_index_for "$name")")"
  if [[ -z "$bg" || -z "$fg" || -z "$red" || -z "$green" || -z "$yellow" || -z "$accent" ]]; then
    echo "theme: could not read GTK colors from $file; GTK left unchanged" >&2
    return 1
  fi

  local dark light
  if [[ "$(contrast_fg "$bg" dark light)" == "dark" ]]; then
    dark="$fg" light="$bg" # light theme: bg is the light end
  else
    dark="$bg" light="$fg"
  fi

  local dir
  dir="$(dirname "$GTK4_CSS")"
  mkdir -p "$dir" || return 1
  # Keep a one-time backup of a gtk.css this script did not generate.
  if [[ -f "$GTK4_CSS" ]] && ! grep -q "$GTK4_MARKER" "$GTK4_CSS"; then
    cp "$GTK4_CSS" "$GTK4_CSS.bak-$(date +%Y%m%d%H%M%S)" || return 1
  fi

  local tmp
  tmp="$(mktemp "$dir/.gtk.css.XXXXXX")" || return 1
  cat >"$tmp" <<EOF || { rm -f "$tmp"; return 1; }
/* $GTK4_MARKER ($name). Do not edit: run \`theme <name>\` instead. */
@define-color accent_color $accent;
@define-color accent_bg_color $accent;
@define-color accent_fg_color $(contrast_fg "$accent" "$dark" "$light");
@define-color destructive_color $red;
@define-color destructive_bg_color $red;
@define-color destructive_fg_color $(contrast_fg "$red" "$dark" "$light");
@define-color success_color $green;
@define-color success_bg_color $green;
@define-color success_fg_color $(contrast_fg "$green" "$dark" "$light");
@define-color warning_color $yellow;
@define-color warning_bg_color $yellow;
@define-color warning_fg_color $(contrast_fg "$yellow" "$dark" "$light");
@define-color error_color $red;
@define-color error_bg_color $red;
@define-color error_fg_color $(contrast_fg "$red" "$dark" "$light");

@define-color window_bg_color $bg;
@define-color window_fg_color $fg;
@define-color view_bg_color $bg;
@define-color view_fg_color $fg;
@define-color headerbar_bg_color mix($bg, $fg, 0.06);
@define-color headerbar_fg_color $fg;
@define-color headerbar_border_color $fg;
@define-color headerbar_backdrop_color $bg;
@define-color headerbar_shade_color rgba(0, 0, 0, 0.36);
@define-color headerbar_darker_shade_color rgba(0, 0, 0, 0.9);
@define-color sidebar_bg_color mix($bg, $fg, 0.04);
@define-color sidebar_fg_color $fg;
@define-color sidebar_backdrop_color mix($bg, $fg, 0.02);
@define-color sidebar_shade_color rgba(0, 0, 0, 0.36);
@define-color secondary_sidebar_bg_color mix($bg, $fg, 0.03);
@define-color secondary_sidebar_fg_color $fg;
@define-color secondary_sidebar_backdrop_color mix($bg, $fg, 0.02);
@define-color secondary_sidebar_shade_color rgba(0, 0, 0, 0.36);
@define-color card_bg_color mix($bg, $fg, 0.05);
@define-color card_fg_color $fg;
@define-color card_shade_color rgba(0, 0, 0, 0.36);
@define-color dialog_bg_color mix($bg, $fg, 0.06);
@define-color dialog_fg_color $fg;
@define-color popover_bg_color mix($bg, $fg, 0.08);
@define-color popover_fg_color $fg;
@define-color popover_shade_color rgba(0, 0, 0, 0.25);
@define-color thumbnail_bg_color mix($bg, $fg, 0.08);
@define-color thumbnail_fg_color $fg;
@define-color shade_color rgba(0, 0, 0, 0.36);
@define-color scrollbar_outline_color rgba(0, 0, 0, 0.5);
EOF
  mv "$tmp" "$GTK4_CSS" || { rm -f "$tmp"; return 1; }

  # GTK4 apps only read gtk.css at startup; quit Nautilus so it reopens themed.
  if command -v nautilus >/dev/null && pgrep -x nautilus >/dev/null; then
    nautilus -q >/dev/null 2>&1 || true
  fi
}

list_themes() {
  local current=""
  if [[ -f "$TARGET" && ! -L "$TARGET" ]]; then
    for f in "$THEMES_DIR"/*.lua; do
      if cmp -s "$f" "$TARGET"; then
        current="$(basename "$f" .lua)"
        break
      fi
    done
  fi

  echo "Available themes:"
  for f in "$THEMES_DIR"/*.lua; do
    local name
    name="$(basename "$f" .lua)"
    if [[ "$name" == "$current" ]]; then
      echo "  * $name (current)"
    else
      echo "    $name"
    fi
  done

  if [[ -f "$GHOSTTY_CONFIG" ]]; then
    local line
    line="$(grep -E '^[[:space:]]*theme[[:space:]]*=' "$GHOSTTY_CONFIG" || true)"
    echo
    echo "Ghostty: ${line:-no theme set}"
  fi
}

set_ghostty_theme() {
  local value="$1"
  mkdir -p "$GHOSTTY_DIR"
  touch "$GHOSTTY_CONFIG"
  if grep -qE '^[[:space:]]*theme[[:space:]]*=' "$GHOSTTY_CONFIG"; then
    local tmp
    tmp="$(mktemp)"
    awk -v v="$value" '
      /^[[:space:]]*theme[[:space:]]*=/ { print "theme = " v; next }
      { print }
    ' "$GHOSTTY_CONFIG" >"$tmp"
    cat "$tmp" >"$GHOSTTY_CONFIG"
    rm -f "$tmp"
  else
    printf 'theme = %s\n' "$value" >>"$GHOSTTY_CONFIG"
  fi
}

main() {
  if [[ $# -eq 0 ]]; then
    list_themes
    return 0
  fi

  local name="$1"
  local source="$THEMES_DIR/$name.lua"
  if [[ ! -f "$source" ]]; then
    echo "theme: unknown theme '$name'" >&2
    echo >&2
    list_themes >&2
    return 1
  fi

  local ghostty_theme
  ghostty_theme="$(ghostty_theme_for "$name")"
  if [[ -z "$ghostty_theme" ]]; then
    echo "theme: no Ghostty theme mapped for '$name'" >&2
    return 1
  fi

  # Replace a leftover symlink (e.g. from Omarchy) with a regular file.
  rm -f "$TARGET"
  cp "$source" "$TARGET"
  set_ghostty_theme "$ghostty_theme"

  # Ghostty reloads its config on SIGUSR2 (verified on 1.3.1), so open windows switch now.
  local ghostty_status="reload with ctrl+shift+,"
  if pgrep -x ghostty >/dev/null 2>&1 && pkill -USR2 -x ghostty 2>/dev/null; then
    ghostty_status="reloaded"
  fi

  local gtk_status="skipped (Ghostty theme file not found)"
  local theme_file
  theme_file="$(ghostty_theme_file "$ghostty_theme")"
  if [[ -n "$theme_file" ]]; then
    if set_gtk4_colors "$name" "$theme_file"; then
      gtk_status="$GTK4_CSS"
    else
      gtk_status="failed (left unchanged)"
    fi
  fi

  echo "Neovim  -> $name"
  echo "Ghostty -> $ghostty_theme ($ghostty_status)"
  echo "GTK4    -> $gtk_status"
  echo
  echo "Restart Neovim to apply the theme there."
  echo "Nautilus and other GTK4 apps pick up the colors when reopened."
}

main "$@"
